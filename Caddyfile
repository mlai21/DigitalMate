# DOMAIN 在 .env 中配置（如 DOMAIN=mate.example.com）。
# 多个域名用空格分隔（如 DOMAIN=ginkgo.xin www.ginkgo.xin），Caddy 会各自签发证书。
# 配置域名后 Caddy 自动向 Let's Encrypt 申请并续期证书，HTTP 自动 301 到 HTTPS。
# Docker Compose 会强制要求 DOMAIN，避免公网 gateway 降级为纯 HTTP。
{$DOMAIN} {
	@attachmentUpload {
		method POST
		path /api/chat/attachments
	}
	request_body @attachmentUpload {
		max_size 11MB
	}
	@channelGateway path /channel-gateway/*
	reverse_proxy @channelGateway agent:3101 {
		header_up -X-DigitalMate-Original-URI
	}
	reverse_proxy web:3000 {
		header_up -X-DigitalMate-Original-URI
		header_up X-DigitalMate-Original-URI {http.request.orig_uri}
	}
}
