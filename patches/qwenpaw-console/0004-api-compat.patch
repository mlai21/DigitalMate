+
+  it("derives stable modes and requires a choice for legacy dual credentials", () => {
+    const helper = requiredHelper<
+      (config: ChannelConfigResponse) => "token" | "password" | null
+    >("deriveMatrixAuthMethod");
+
+    expect(
+      helper(
+        configWithSecrets({
