diff --git a/src/pages/Control/Channels/channelSecurity.ts b/src/pages/Control/Channels/channelSecurity.ts
new file mode 100644
index 0000000..8bcefd6
--- /dev/null
+++ b/src/pages/Control/Channels/channelSecurity.ts
@@ -0,0 +1,345 @@
+import type {
+  ChannelSchema,
+} from "../../../api/modules/channel";
+import {
+  ApiError,
+  isRetryableRequestError,
+} from "../../../api/request";
+import type {
+  ChannelConfigResponse,
+  ChannelUpdatePayload,
+  SecretStatus,
+} from "../../../api/types/channel";
+
+const RESPONSE_ONLY_FIELDS = new Set([
+  "health",
+  "isBuiltin",
+  "revision",
+]);
+
+export const channelQrCodeEnabled = false;
+
+export function isSecretStatus(value: unknown): value is SecretStatus {
+  if (
+    typeof value !== "object" ||
+    value === null ||
+    Array.isArray(value)
+  ) {
+    return false;
+  }
+  const record = value as Record<string, unknown>;
+  return (
+    typeof record.configured === "boolean" &&
+    (
+      record.lastRotatedAt === null ||
+      typeof record.lastRotatedAt === "string"
+    )
+  );
+}
+
+export function isChannelSecretConfigured(
+  config: Readonly<Record<string, unknown>> | undefined,
+  fieldName: string,
+): boolean {
+  const status = config?.[fieldName];
+  return isSecretStatus(status) && status.configured;
+}
+
+export function isChannelSecretRequired(
+  config: Readonly<Record<string, unknown>> | undefined,
+  schema: ChannelSchema | undefined,
+  fieldName: string,
+  requiredOverride?: boolean,
+): boolean {
+  const field = schema?.config_fields.find(
+    (candidate) =>
+      candidate.name === fieldName &&
+      candidate.type === "password",
+  );
+  const required = requiredOverride ?? field?.required === true;
+  return required && !isChannelSecretConfigured(config, fieldName);
+}
+
+export function deriveMatrixAuthMethod(
+  config: Readonly<Record<string, unknown>>,
+): "token" | "password" | null {
+  const tokenConfigured = isChannelSecretConfigured(
+    config,
+    "access_token",
+  );
+  const passwordConfigured = isChannelSecretConfigured(
+    config,
+    "password",
+  );
+  if (tokenConfigured && passwordConfigured) return null;
+  if (passwordConfigured) return "password";
+  return "token";
+}
+
+export function normalizeChannelFormValues(
+  config: ChannelConfigResponse,
+  schema: ChannelSchema,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  for (const field of schema.config_fields) {
+    if (field.type === "password") {
+      result[field.name] = "";
+      result[`clear_secret_${field.name}`] = false;
+      continue;
+    }
+    const value = config[field.name];
+    if (!RESPONSE_ONLY_FIELDS.has(field.name) && value !== undefined) {
+      result[field.name] =
+        field.name === "allow_from" && value === null ? [] : value;
+    }
+  }
+  result.filter_tool_messages = true;
+  result.filter_thinking = true;
+  return result;
+}
+
+export function buildChannelSavePayload(
+  current: ChannelConfigResponse,
+  values: Record<string, unknown>,
+  schema: ChannelSchema,
+  operationId: string,
+  channelType?: string,
+): ChannelUpdatePayload {
+  const payload: ChannelUpdatePayload = {
+    operation_id: operationId,
+    revision:
+      typeof current.revision === "number" ? current.revision : 0,
+    clear_secret: [],
+  };
+  const matrixAuthMethod =
+    channelType === "matrix" &&
+    (
+      values.auth_method === "token" ||
+      values.auth_method === "password"
+    )
+      ? values.auth_method
+      : null;
+  const inactiveMatrixSecret =
+    matrixAuthMethod === "token"
+      ? "password"
+      : matrixAuthMethod === "password"
+        ? "access_token"
+        : null;
+
+  for (const field of schema.config_fields) {
+    if (field.type === "password") {
+      if (field.name === inactiveMatrixSecret) {
+        continue;
+      }
+      const nextValue = values[field.name];
+      if (typeof nextValue === "string" && nextValue.length > 0) {
+        payload[field.name] = nextValue;
+      }
+      if (values[`clear_secret_${field.name}`] === true) {
+        payload.clear_secret.push(field.name);
+      }
+      continue;
+    }
+    const currentValue = current[field.name];
+    if (
+      isPublicFieldValue(currentValue) &&
+      !isSecretStatus(currentValue) &&
+      !RESPONSE_ONLY_FIELDS.has(field.name)
+    ) {
+      payload[field.name] = currentValue;
+    }
+    const nextValue = values[field.name];
+    if (
+      field.name === "allow_from" &&
+      currentValue === null &&
+      Array.isArray(nextValue) &&
+      nextValue.length === 0
+    ) {
+      payload[field.name] = null;
+    } else if (isPublicFieldValue(nextValue)) {
+      payload[field.name] = nextValue;
+    }
+  }
+  if (
+    inactiveMatrixSecret &&
+    !payload.clear_secret.includes(inactiveMatrixSecret)
+  ) {
+    payload.clear_secret.push(inactiveMatrixSecret);
+  }
+  if (matrixAuthMethod === "token") {
+    payload.encryption = false;
+  }
+  payload.filter_tool_messages = true;
+  payload.filter_thinking = true;
+  return payload;
+}
+
+type ChannelFormFieldError = {
+  name: string;
+  errors: string[];
+};
+
+export function mapChannelApiErrorToFormFields(
+  error: unknown,
+  schema: ChannelSchema,
+): ChannelFormFieldError[] | null {
+  if (
+    !(error instanceof ApiError) ||
+    error.status !== 400 ||
+    error.code !== "invalid_request" ||
+    typeof error.details !== "object" ||
+    error.details === null ||
+    Array.isArray(error.details)
+  ) {
+    return null;
+  }
+  const issues = Reflect.get(error.details, "issues");
+  if (!Array.isArray(issues) || issues.length === 0 || issues.length > 64) {
+    return null;
+  }
+  const fieldByName = new Map(
+    schema.config_fields.map((field) => [field.name, field]),
+  );
+  const mapped = new Map<string, ChannelFormFieldError>();
+  for (const issue of issues) {
+    if (
+      typeof issue !== "object" ||
+      issue === null ||
+      Array.isArray(issue)
+    ) {
+      continue;
+    }
+    const path = Reflect.get(issue, "path");
+    const code = Reflect.get(issue, "code");
+    if (
+      !Array.isArray(path) ||
+      path.length === 0 ||
+      path.length > 16 ||
+      typeof code !== "string"
+    ) {
+      continue;
+    }
+    const resolved = resolveIssueFieldName(path, fieldByName);
+    if (!resolved || mapped.has(resolved.name)) continue;
+    const field = fieldByName.get(resolved.fieldName);
+    if (!field) continue;
+    const label =
+      typeof field.label === "string" && field.label.length > 0
+        ? field.label
+        : field.name;
+    const message = resolved.clearSecret
+      ? `${label}清除选项无效`
+      : code === "too_big" || code === "too_small"
+        ? `${label}超出允许范围`
+        : `${label}格式不正确`;
+    mapped.set(resolved.name, {
+      name: resolved.name,
+      errors: [message],
+    });
+  }
+  return mapped.size > 0 ? [...mapped.values()] : null;
+}
+
+export function handleChannelSaveError(
+  error: unknown,
+  schema: ChannelSchema,
+  setFields: (fields: ChannelFormFieldError[]) => void,
+  showGenericError: () => void,
+): boolean {
+  const fieldErrors = mapChannelApiErrorToFormFields(error, schema);
+  if (fieldErrors) {
+    setFields(fieldErrors);
+    return true;
+  }
+  showGenericError();
+  return false;
+}
+
+function resolveIssueFieldName(
+  path: unknown[],
+  fieldByName: ReadonlyMap<string, unknown>,
+):
+  | {
+      name: string;
+      fieldName: string;
+      clearSecret: boolean;
+    }
+  | null {
+  const safePath = path.map((segment) =>
+    typeof segment === "number" ? String(segment) : segment
+  );
+  if (!safePath.every((segment) => typeof segment === "string")) {
+    return null;
+  }
+  const clearIndex = safePath.indexOf("clear_secret");
+  if (clearIndex >= 0) {
+    const fieldName = safePath
+      .slice(clearIndex + 1)
+      .find((segment) => fieldByName.has(segment));
+    return fieldName
+      ? {
+          name: `clear_secret_${fieldName}`,
+          fieldName,
+          clearSecret: true,
+        }
+      : null;
+  }
+  const fieldName = safePath.find((segment) =>
+    fieldByName.has(segment)
+  );
+  return fieldName
+    ? { name: fieldName, fieldName, clearSecret: false }
+    : null;
+}
+
+function isPublicFieldValue(
+  value: unknown,
+): value is
+  | boolean
+  | number
+  | string
+  | string[]
+  | null
+  | Record<string, unknown> {
+  return (
+    value === null ||
+    typeof value === "boolean" ||
+    typeof value === "number" ||
+    typeof value === "string" ||
+    (
+      Array.isArray(value) &&
+      value.every((item) => typeof item === "string")
+    ) ||
+    (
+      typeof value === "object" &&
+      value !== null &&
+      !Array.isArray(value)
+    )
+  );
+}
+
+export async function saveChannelWithRetry<T>(
+  save: (payload: ChannelUpdatePayload) => Promise<T>,
+  payload: ChannelUpdatePayload,
+): Promise<T> {
+  try {
+    return await save(payload);
+  } catch (error) {
+    if (!isRetryableRequestError(error)) throw error;
+    return save(payload);
+  }
+}
+
+export async function refreshChannelAfterRevisionConflict<T>(
+  error: unknown,
+  refresh: () => Promise<T>,
+): Promise<T | null> {
+  if (
+    !(error instanceof ApiError) ||
+    error.status !== 409 ||
+    error.code !== "config_revision_conflict"
+  ) {
+    return null;
+  }
+  return refresh();
+}
