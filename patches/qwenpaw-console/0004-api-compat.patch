+import { describe, expect, it, vi } from "vitest";
+import {
+  buildAgentProfileUpdate,
+  createAgentProfileUpdate,
+} from "./profileForm";
+
+const OPERATION_ID = "30000000-0000-4000-8000-000000000031";
+
+const profileValues = {
+  id: "10000000-0000-4000-8000-000000000011",
+  name: "  DigitalMate  ",
+  persona: {
+    name: "  小D  ",
+    style: "  真诚、简洁  ",
+    emojiHabit: "  偶尔使用 🙂  ",
+  },
+  settings: {
+    proactivity: {
+      quietStart: "23:00",
+      quietEnd: "08:00",
+      minIntervalMinutes: 30,
+      maxPerHour: 2,
+      maxPerDay: 6,
+    },
+    cadence: {
+      responseDelayMs: 300,
+      segmentDelayMs: 500,
+      maxSegments: 4,
+    },
+    search: {
+      aggressiveness: "conservative" as const,
+    },
+  },
+  revision: 7,
+  active_model: { provider_id: "secret", model: "secret-model" },
+  tools: ["hidden"],
+  skills: ["hidden"],
+  workspace_dir: "/hidden",
+};
+
+describe("buildAgentProfileUpdate", () => {
+  it("only serializes the approved single-avatar profile fields", () => {
+    expect(
+      buildAgentProfileUpdate(profileValues, OPERATION_ID),
+    ).toEqual({
+      id: "10000000-0000-4000-8000-000000000011",
+      name: "DigitalMate",
+      persona: {
+        name: "小D",
+        style: "真诚、简洁",
+        emojiHabit: "偶尔使用 🙂",
+      },
+      settings: {
+        proactivity: {
+          quietStart: "23:00",
+          quietEnd: "08:00",
+          minIntervalMinutes: 30,
+          maxPerHour: 2,
+          maxPerDay: 6,
+        },
+        cadence: {
+          responseDelayMs: 300,
+          segmentDelayMs: 500,
+          maxSegments: 4,
+        },
+        search: {
+          aggressiveness: "conservative",
+        },
+      },
+      revision: 7,
+      operation_id: OPERATION_ID,
+    });
+  });
+
+  it("generates exactly one operation id for one save payload", () => {
+    const createOperationId = vi.fn(() => OPERATION_ID);
+
+    expect(
+      createAgentProfileUpdate(profileValues, createOperationId),
+    ).toMatchObject({ operation_id: OPERATION_ID });
+    expect(createOperationId).toHaveBeenCalledTimes(1);
