+  buildChannelSavePayload,
+  normalizeChannelFormValues,
+  saveChannelWithRetry,
+} from "./channelSecurity";
+
+const OPERATION_ID = "30000000-0000-4000-8000-000000000031";
+const SECRET_FIELDS_BY_CHANNEL = {
+  imessage: [],
+  discord: ["bot_token", "http_proxy_auth"],
+  dingtalk: ["client_secret"],
+  feishu: ["app_secret", "encrypt_key", "verification_token"],
+  qq: ["client_secret"],
+  telegram: ["bot_token", "http_proxy_auth"],
+  mattermost: ["bot_token"],
+  mqtt: ["password", "tls_keyfile"],
+  matrix: ["access_token", "password"],
+  slack: ["bot_token", "app_token"],
+  voice: ["twilio_auth_token"],
+  sip: [
+    "sip_password",
+    "dashscope_api_key",
+    "livekit_api_key",
+    "livekit_api_secret",
+  ],
+  wecom: ["secret"],
+  xiaoyi: ["sk"],
+  yuanbao: ["app_secret"],
+  wechat: ["bot_token", "bot_token_file"],
+  onebot: ["access_token"],
+} as const;
+const SECRET_FIELDS = [
+  ...new Set(Object.values(SECRET_FIELDS_BY_CHANNEL).flat()),
+];
+const schema = {
+  label: "Telegram",
+  description: "Telegram",
+  plugin_id: null,
+  config_fields: [
+    {
+      name: "enabled",
+      label: "Enabled",
+      type: "switch",
+      default: false,
+    },
+    {
+      name: "filter_tool_messages",
+      label: "Filter tools",
+      type: "switch",
+      default: true,
+      readonly: true,
+    },
+    {
+      name: "filter_thinking",
+      label: "Filter thinking",
+      type: "switch",
+      default: true,
+      readonly: true,
+    },
+    {
+      name: "bot_token",
+      label: "Bot Token",
+      type: "password",
+      default: "",
+    },
+  ],
+} satisfies ChannelSchema;
+
+describe("channel secret form contract", () => {
+  it("reads every secret configured state by its own manifest field name", () => {
+    const helper = requiredHelper<
+      (config: ChannelConfigResponse, fieldName: string) => boolean
+    >("isChannelSecretConfigured");
+
+    expect(Object.keys(SECRET_FIELDS_BY_CHANNEL)).toHaveLength(17);
+    for (const [channelType, fieldNames] of Object.entries(
+      SECRET_FIELDS_BY_CHANNEL,
+    )) {
+      for (const fieldName of fieldNames) {
+        const config = configWithSecrets({
+          [fieldName]: {
+            configured: true,
+            lastRotatedAt: "2026-07-25T00:00:00.000Z",
+          },
+        });
+        expect(
+          helper(config, fieldName),
+          `${channelType}.${fieldName}`,
+        ).toBe(true);
+        expect(
+          helper(config, `${fieldName}_other`),
+          `${channelType}.${fieldName}`,
+        ).toBe(false);
+      }
+    }
+  });
+
+  it.each([
+    ["client_secret", "app_secret"],
+    ["app_secret", "bot_token"],
+    ["client_secret", "app_token"],
+    ["bot_token", "twilio_auth_token"],
+  ])(
+    "does not substitute configured state for %s from %s",
+    (fieldName, wrongFieldName) => {
+      const helper = requiredHelper<
+        (config: ChannelConfigResponse, fieldName: string) => boolean
+      >("isChannelSecretConfigured");
+      const config = configWithSecrets({
+        [fieldName]: { configured: true, lastRotatedAt: null },
+        [wrongFieldName]: { configured: false, lastRotatedAt: null },
+      });
+
+      expect(helper(config, fieldName)).toBe(true);
+    },
+  );
+
+  it("requires an empty required secret only when its own status is unconfigured", () => {
+    const helper = requiredHelper<
+      (
+        config: ChannelConfigResponse,
+        schema: ChannelSchema,
+        fieldName: string,
+      ) => boolean
+    >("isChannelSecretRequired");
+    const requiredSchema = secretSchema("client_secret", true);
+
+    expect(
+      helper(
+        configWithSecrets({
+          client_secret: { configured: false, lastRotatedAt: null },
+        }),
+        requiredSchema,
+        "client_secret",
+      ),
+    ).toBe(true);
+    expect(
+      helper(
+        configWithSecrets({
+          client_secret: { configured: true, lastRotatedAt: null },
+        }),
+        requiredSchema,
+        "client_secret",
+      ),
+    ).toBe(false);
+  });
+
+  it("retains every configured empty secret when no clear was requested", () => {
+    const allSecretsSchema = {
+      label: "All secrets",
+      description: "All secrets",
+      plugin_id: null,
+      config_fields: SECRET_FIELDS.map((name) => ({
+        name,
+        label: name,
+        type: "password" as const,
+        required: true,
+        default: "",
+      })),
+    } satisfies ChannelSchema;
+    const current = configWithSecrets(
+      Object.fromEntries(
+        SECRET_FIELDS.map((name) => [
+          name,
+          { configured: true, lastRotatedAt: null },
+        ]),
+      ),
+    );
+    const values = Object.fromEntries(
+      SECRET_FIELDS.flatMap((name) => [
+        [name, ""],
+        [`clear_secret_${name}`, false],
+      ]),
+    );
+    const payload = buildChannelSavePayload(
+      current,
+      values,
+      allSecretsSchema,
+      OPERATION_ID,
+    );
+
+    expect(payload.clear_secret).toEqual([]);
+    for (const fieldName of SECRET_FIELDS) {
+      expect(payload).not.toHaveProperty(fieldName);
+    }
+  });
+
+  it("never refills a configured secret status as a form value", () => {
+    expect(
+      normalizeChannelFormValues(
+        {
+          enabled: true,
+          revision: 4,
+          isBuiltin: true,
+          health: { status: "blocked", detail: {} },
+          filter_tool_messages: true,
+          filter_thinking: true,
+          bot_token: {
+            configured: true,
+            lastRotatedAt: "2026-07-25T00:00:00.000Z",
+          },
+        },
+        schema,
+      ),
+    ).toEqual({
+      enabled: true,
+      filter_tool_messages: true,
+      filter_thinking: true,
+      bot_token: "",
+      clear_secret_bot_token: false,
+    });
+  });
+
+  it("builds an explicit clear and forces both filters true", () => {
+    expect(
+      buildChannelSavePayload(
+        {
+          enabled: true,
+          revision: 4,
+          isBuiltin: true,
+          health: { status: "blocked", detail: {} },
+          bot_token: {
+            configured: true,
+            lastRotatedAt: "2026-07-25T00:00:00.000Z",
+          },
+        },
+        {
+          enabled: false,
+          filter_tool_messages: false,
+          filter_thinking: false,
+          bot_token: "",
+          clear_secret_bot_token: true,
+        },
+        schema,
+        OPERATION_ID,
+      ),
+    ).toEqual({
+      operation_id: OPERATION_ID,
+      revision: 4,
+      enabled: false,
+      filter_tool_messages: true,
+      filter_thinking: true,
+      clear_secret: ["bot_token"],
+    });
+  });
+
+  it("reuses one operation id for the single bounded retry", async () => {
+    const save = vi
+      .fn()
+      .mockRejectedValueOnce(new RetryableRequestError("transport"))
+      .mockResolvedValueOnce({ revision: 1 });
+    const payload = {
+      operation_id: OPERATION_ID,
+      revision: 0,
+      clear_secret: [],
+    };
+
+    await expect(saveChannelWithRetry(save, payload)).resolves.toEqual({
+      revision: 1,
+    });
+    expect(save).toHaveBeenNthCalledWith(1, payload);
+    expect(save).toHaveBeenNthCalledWith(2, payload);
+    expect(save).toHaveBeenCalledTimes(2);
+  });
+
+  it.each(["transport", "timeout"] as const)(
+    "retries one explicit retryable %s error with the exact same payload",
+    async (kind) => {
+      const retryable = Object.assign(new Error(kind), {
+        name: "RetryableRequestError",
+        kind,
+        retryable: true as const,
+      });
+      const save = vi
+        .fn()
+        .mockRejectedValueOnce(retryable)
+        .mockResolvedValueOnce({ revision: 1 });
+      const payload = {
+        operation_id: OPERATION_ID,
+        revision: 0,
+        clear_secret: [],
+      };
+
+      await expect(saveChannelWithRetry(save, payload)).resolves.toEqual({
+        revision: 1,
+      });
+      expect(save).toHaveBeenNthCalledWith(1, payload);
+      expect(save).toHaveBeenNthCalledWith(2, payload);
+      expect(save).toHaveBeenCalledTimes(2);
+    },
+  );
+
+  it("does not retry an authoritative HTTP error", async () => {
+    const error = new Error("409");
+    const save = vi.fn().mockRejectedValue(error);
+
+    await expect(
+      saveChannelWithRetry(save, {
+        operation_id: OPERATION_ID,
+        revision: 0,
+        clear_secret: [],
+      }),
+    ).rejects.toBe(error);
+    expect(save).toHaveBeenCalledTimes(1);
+  });
+
+  it("refreshes exactly once on revision conflict without mutating form input", async () => {
+    const helper = requiredHelper<
+      <T>(
+        error: unknown,
+        refresh: () => Promise<T>,
+      ) => Promise<T | null>
+    >("refreshChannelAfterRevisionConflict");
+    const draft = { bot_prefix: "尚未保存的输入" };
+    const refresh = vi.fn().mockResolvedValue({
+      revision: 3,
+      bot_prefix: "server",
+    });
+    const conflict = new ApiError("revision_conflict", {
+      status: 409,
+      code: "config_revision_conflict",
+    });
+
+    await expect(helper(conflict, refresh)).resolves.toEqual({
+      revision: 3,
+      bot_prefix: "server",
+    });
+    expect(refresh).toHaveBeenCalledTimes(1);
+    expect(draft).toEqual({ bot_prefix: "尚未保存的输入" });
+  });
+
+  it("does not loop when the one conflict refresh fails", async () => {
+    const helper = requiredHelper<
+      <T>(
+        error: unknown,
+        refresh: () => Promise<T>,
+      ) => Promise<T | null>
+    >("refreshChannelAfterRevisionConflict");
+    const refreshFailure = new Error("refresh unavailable");
+    const refresh = vi.fn().mockRejectedValue(refreshFailure);
+    const conflict = new ApiError("revision_conflict", {
+      status: 409,
+      code: "config_revision_conflict",
+    });
+
+    await expect(helper(conflict, refresh)).rejects.toBe(refreshFailure);
+    expect(refresh).toHaveBeenCalledTimes(1);
+  });
+});
+
+describe("Matrix credential switching", () => {
+  const matrixSchema = {
+    label: "Matrix",
+    description: "Matrix",
+    plugin_id: null,
+    config_fields: [
+      {
+        name: "access_token",
+        label: "Access Token",
+        type: "password",
+        required: true,
+        default: "",
+      },
+      {
+        name: "password",
+        label: "Password",
+        type: "password",
