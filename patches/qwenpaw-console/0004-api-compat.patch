+      value: {
+        pathname: "/admin/settings/models",
+        search: "",
+        assign: vi.fn(),
+      },
+      writable: true,
+    });
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.useRealTimers();
+  });
+
+  it("refreshes after 31 minutes and sends the mutation exactly once", async () => {
+    setCsrfToken(
+      "initial-token",
+      Math.floor(Date.now() / 1_000) + 1_800,
+    );
+    vi.advanceTimersByTime(31 * 60 * 1_000);
+    global.fetch = vi.fn(async (url) => {
+      if (url === "/api/admin/compat/auth/status") {
+        return Response.json({
+          authenticated: true,
+          csrf_token: "refreshed-token",
+          csrf_expires_at:
+            Math.floor(Date.now() / 1_000) + 1_800,
+        });
+      }
+      return Response.json({ ok: true });
+    });
+
+    await request("/models", { method: "POST", body: "{}" });
+
+    expect(fetch).toHaveBeenCalledTimes(2);
+    expect(
+      vi.mocked(fetch).mock.calls.filter(
+        ([url]) => url === "/api/admin/compat/models",
+      ),
+    ).toHaveLength(1);
+    const mutationOptions = vi.mocked(fetch).mock.calls[1]?.[1];
+    expect(new Headers(mutationOptions?.headers).get("x-csrf-token"))
+      .toBe("refreshed-token");
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("does not refresh or replay a general 403 response", async () => {
+    setCsrfToken(
+      "fresh-token",
+      Math.floor(Date.now() / 1_000) + 1_800,
+    );
+    global.fetch = vi.fn().mockResolvedValue(
+      Response.json(
+        { error: { code: "forbidden" } },
+        { status: 403 },
+      ),
+    );
+
+    await expect(
+      request("/models", { method: "POST", body: "{}" }),
+    ).rejects.toThrow();
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+
+  it("routes a refresh 401 to safe login without sending the mutation", async () => {
+    setCsrfToken("expired-token", 1);
+    global.fetch = vi.fn().mockResolvedValue(
+      Response.json({}, { status: 401 }),
+    );
+
+    await expect(
+      request("/models", { method: "POST", body: "{}" }),
+    ).rejects.toThrow("Not authenticated");
+    expect(fetch).toHaveBeenCalledTimes(1);
+    expect(window.location.assign).toHaveBeenCalledWith(
+      "/login?redirect=%2Fadmin%2Fsettings%2Fmodels",
+    );
+  });
+});
diff --git a/src/api/logout.test.ts b/src/api/logout.test.ts
new file mode 100644
index 0000000..df2c0d9
--- /dev/null
+++ b/src/api/logout.test.ts
@@ -0,0 +1,43 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { logoutAndRedirect } from "./logout";
+import { authApi } from "./modules/auth";
+import { clearAuthToken } from "./config";
+
+vi.mock("./modules/auth", () => ({
+  authApi: { logout: vi.fn() },
+}));
+vi.mock("./config", () => ({
+  clearAuthToken: vi.fn(),
+}));
+
+describe("DigitalMate logout handoff", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    Object.defineProperty(window, "location", {
+      value: { assign: vi.fn() },
+      writable: true,
+    });
+  });
+
+  it("clears memory and redirects only after server revocation succeeds", async () => {
+    vi.mocked(authApi.logout).mockResolvedValue(undefined);
+
+    await logoutAndRedirect();
+
+    expect(authApi.logout).toHaveBeenCalledOnce();
+    expect(vi.mocked(authApi.logout).mock.invocationCallOrder[0])
+      .toBeLessThan(vi.mocked(clearAuthToken).mock.invocationCallOrder[0]);
+    expect(clearAuthToken).toHaveBeenCalledOnce();
+    expect(window.location.assign).toHaveBeenCalledWith("/login");
+  });
+
+  it("does not clear or redirect when server revocation fails", async () => {
+    vi.mocked(authApi.logout).mockRejectedValue(
+      new Error("Logout failed"),
+    );
+
+    await expect(logoutAndRedirect()).rejects.toThrow("Logout failed");
+    expect(clearAuthToken).not.toHaveBeenCalled();
+    expect(window.location.assign).not.toHaveBeenCalled();
+  });
+});
