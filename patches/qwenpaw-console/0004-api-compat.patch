+    expect(payload).not.toHaveProperty("auth_method");
+    expect(payload).not.toHaveProperty("access_token");
+  });
+
+  it("keeps the configured active credential on empty input while clearing the inactive one", () => {
+    const payload = buildMatrixPayload(
+      configWithSecrets({
+        access_token: { configured: true, lastRotatedAt: null },
+        password: { configured: true, lastRotatedAt: null },
+      }),
+      {
+        auth_method: "token",
+        access_token: "",
+        password: "",
+      },
