+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { buildAuthHeaders, buildMutationHeaders } from "./authHeaders";
+import { setCsrfToken } from "./config";
+import {
+  clearValidatedDefaultAgent,
+  markValidatedDefaultAgent,
+} from "./agentScope";
+
+const DEFAULT_AGENT_ID = "10000000-0000-4000-8000-000000000011";
+
+describe("auth headers", () => {
+  beforeEach(() => {
+    sessionStorage.clear();
+    localStorage.clear();
+    clearValidatedDefaultAgent();
+    sessionStorage.setItem(
+      "qwenpaw-agent-storage",
+      JSON.stringify({ state: { selectedAgent: "default" } }),
+    );
+    setCsrfToken(
+      "csrf-value",
+      Math.floor(Date.now() / 1_000) + 1_800,
+    );
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.useRealTimers();
+  });
+
+  it("does not send the legacy placeholder before the first agent list", () => {
+    expect(buildAuthHeaders()).toEqual({});
+  });
+
+  it("sends the real selected UUID through both compatibility headers", () => {
+    markValidatedDefaultAgent(DEFAULT_AGENT_ID);
+    sessionStorage.setItem(
+      "qwenpaw-agent-storage",
+      JSON.stringify({
+        state: { selectedAgent: DEFAULT_AGENT_ID },
+      }),
+    );
+    markValidatedDefaultAgent(DEFAULT_AGENT_ID);
+    expect(buildAuthHeaders()).toEqual({
+      "X-Agent-Id": DEFAULT_AGENT_ID,
+      "x-digitalmate-agent-id": DEFAULT_AGENT_ID,
+    });
+  });
+
+  it.each(["GET", "HEAD", "OPTIONS"])(
+    "does not attach CSRF to %s",
+    async (method) => {
+      await expect(buildMutationHeaders(method)).resolves.toEqual({});
+    },
+  );
+
+  it.each(["POST", "PUT", "PATCH", "DELETE"])(
+    "attaches in-memory CSRF to %s",
+    async (method) => {
+      await expect(buildMutationHeaders(method)).resolves.toEqual({
+        "x-csrf-token": "csrf-value",
+      });
+    },
+  );
+
+  it("refreshes an expired token once before returning mutation headers", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-07-24T00:00:00.000Z"));
+    setCsrfToken("old-token", 1_753_315_200);
+    vi.advanceTimersByTime(31 * 60 * 1_000);
+    sessionStorage.setItem(
+      "qwenpaw-agent-storage",
+      JSON.stringify({
+        state: { selectedAgent: DEFAULT_AGENT_ID },
+      }),
+    );
+    markValidatedDefaultAgent(DEFAULT_AGENT_ID);
+    global.fetch = vi.fn().mockResolvedValue(
+      Response.json({
+        authenticated: true,
+        csrf_token: "fresh-token",
+        csrf_expires_at:
+          Math.floor(Date.now() / 1_000) + 1_800,
+      }),
+    );
+    const baselineTimerCount = vi.getTimerCount();
+
+    await expect(buildMutationHeaders("POST")).resolves.toMatchObject({
+      "x-csrf-token": "fresh-token",
+      "x-digitalmate-agent-id": DEFAULT_AGENT_ID,
+    });
+    expect(fetch).toHaveBeenCalledTimes(1);
+    expect(fetch).toHaveBeenCalledWith(
+      "/api/admin/compat/auth/status",
+      expect.objectContaining({ credentials: "same-origin" }),
+    );
+    expect(localStorage.length).toBe(0);
+    expect(sessionStorage.getItem("csrf_token")).toBeNull();
+    expect(vi.getTimerCount()).toBe(baselineTimerCount);
+  });
+
+  it("bounds a shared half-open refresh and resets it for the next caller", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-07-24T00:00:00.000Z"));
+    setCsrfToken("", null);
+    let refreshSignal: AbortSignal | undefined;
+    global.fetch = vi.fn((_input, init) => {
+      refreshSignal = init?.signal ?? undefined;
+      return new Promise<Response>((_resolve, reject) => {
+        refreshSignal?.addEventListener(
+          "abort",
+          () => reject(refreshSignal?.reason),
+          { once: true },
+        );
+      });
+    });
+
+    const first = buildMutationHeaders("POST");
+    const second = buildMutationHeaders("DELETE");
+    const resultsPromise = Promise.allSettled([first, second]);
+    await Promise.resolve();
+
+    expect(fetch).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(10_000);
+    expect(refreshSignal).toBeInstanceOf(AbortSignal);
+    expect(refreshSignal?.aborted).toBe(true);
+    const results = await resultsPromise;
+    expect(results.map(({ status }) => status)).toEqual([
+      "rejected",
+      "rejected",
+    ]);
+    expect(vi.getTimerCount()).toBe(0);
+    expect(localStorage.length).toBe(0);
+    expect(sessionStorage.getItem("csrf_token")).toBeNull();
+
+    vi.mocked(fetch).mockResolvedValueOnce(
+      Response.json({
+        authenticated: true,
+        csrf_token: "recovered-token",
+        csrf_expires_at:
+          Math.floor(Date.now() / 1_000) + 1_800,
+      }),
+    );
+    await expect(buildMutationHeaders("POST")).resolves.toMatchObject({
+      "x-csrf-token": "recovered-token",
+    });
+    expect(fetch).toHaveBeenCalledTimes(2);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("lets one caller cancel without cancelling the shared refresh", async () => {
+    setCsrfToken("", null);
+    let resolveRefresh: ((response: Response) => void) | undefined;
+    global.fetch = vi.fn((input) => {
+      if (input === "/api/mutation") {
+        return Promise.resolve(Response.json({ ok: true }));
+      }
+      return (
+        new Promise<Response>((resolve) => {
+          resolveRefresh = resolve;
+        })
+      );
+    });
+    const mutate = async (signal?: AbortSignal) => {
+      const headers = await buildMutationHeaders("POST", signal);
+      return fetch("/api/mutation", {
+        method: "POST",
+        headers,
+        signal,
+      });
+    };
+    const controller = new AbortController();
+    const first = mutate(controller.signal);
+    const cancellation = first.then(
+      () => undefined,
+      (error: unknown) => error,
+    );
+    const second = mutate();
+
+    controller.abort();
+    const cancelled = await cancellation;
+    expect(cancelled).toMatchObject({ name: "AbortError" });
+    expect(fetch).toHaveBeenCalledTimes(1);
+
+    resolveRefresh?.(
+      Response.json({
+        authenticated: true,
+        csrf_token: "shared-token",
+        csrf_expires_at:
+          Math.floor(Date.now() / 1_000) + 1_800,
+      }),
+    );
+    await expect(second).resolves.toMatchObject({ ok: true });
+    await expect(first).rejects.toMatchObject({ name: "AbortError" });
+    expect(fetch).toHaveBeenCalledTimes(2);
+    expect(fetch).toHaveBeenCalledWith(
+      "/api/mutation",
+      expect.objectContaining({
+        method: "POST",
+        headers: expect.objectContaining({
+          "x-csrf-token": "shared-token",
+        }),
+      }),
+    );
+  });
+
+  it("removes a caller abort listener after the shared refresh settles", async () => {
+    vi.useFakeTimers();
+    vi.setSystemTime(new Date("2026-07-24T00:00:00.000Z"));
+    setCsrfToken("", null);
+    const controller = new AbortController();
+    const removeSpy = vi.spyOn(
+      controller.signal,
+      "removeEventListener",
+    );
+    global.fetch = vi.fn().mockResolvedValue(
+      Response.json({
+        authenticated: true,
+        csrf_token: "listener-cleanup-token",
+        csrf_expires_at:
+          Math.floor(Date.now() / 1_000) + 1_800,
+      }),
+    );
+
+    await expect(
+      buildMutationHeaders("POST", controller.signal),
+    ).resolves.toMatchObject({
+      "x-csrf-token": "listener-cleanup-token",
+    });
+
+    expect(removeSpy).toHaveBeenCalledWith("abort", expect.any(Function));
+    expect(vi.getTimerCount()).toBe(0);
+  });
+});
