+
+/** X-Agent-Id plus in-memory CSRF for state-changing requests only. */
+export async function buildMutationHeaders(
+  method: string,
+  callerSignal?: AbortSignal | null,
+): Promise<Record<string, string>> {
+  const headers = buildAuthHeaders();
+  if (!MUTATION_METHODS.has(method.toUpperCase())) {
+    return headers;
+  }
+  throwIfCallerAborted(callerSignal);
+  await ensureFreshCsrfToken(callerSignal);
+  throwIfCallerAborted(callerSignal);
+  const csrfToken = getCsrfToken();
+  if (csrfToken) {
+    headers["x-csrf-token"] = csrfToken;
+  }
+  return headers;
+}
+
+async function ensureFreshCsrfToken(
+  callerSignal?: AbortSignal | null,
+): Promise<void> {
+  if (hasFreshCsrfToken()) return;
+  if (!csrfRefresh) {
+    csrfRefresh = refreshCsrfToken().finally(() => {
+      csrfRefresh = null;
+    });
+  }
+  await waitForSharedRefresh(csrfRefresh, callerSignal);
+}
+
+async function refreshCsrfToken(): Promise<void> {
+  const controller = new AbortController();
+  let timeoutId: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<never>((_resolve, reject) => {
+    timeoutId = setTimeout(() => {
+      const error = new DOMException(
+        `CSRF refresh timeout after ${CSRF_REFRESH_TIMEOUT_MS}ms`,
+        "TimeoutError",
+      );
+      controller.abort(error);
+      reject(error);
+    }, CSRF_REFRESH_TIMEOUT_MS);
+  });
+  let response: Response;
+  try {
+    response = await Promise.race([
+      fetch("/api/admin/compat/auth/status", {
+        credentials: "same-origin",
+        headers: { Accept: "application/json" },
+        signal: controller.signal,
+      }),
+      timeout,
+    ]);
+  } finally {
+    if (timeoutId !== undefined) {
+      clearTimeout(timeoutId);
+    }
+  }
+  if (response.status === 401) {
+    clearAuthToken();
+    redirectToDigitalMateLogin();
+    throw new Error("Not authenticated");
+  }
+  if (!response.ok) {
+    throw new Error("Failed to refresh CSRF token");
+  }
+  const result = (await response.json()) as {
+    authenticated?: unknown;
+    csrf_token?: unknown;
+    csrf_expires_at?: unknown;
+  };
+  if (
+    result.authenticated !== true ||
+    typeof result.csrf_token !== "string" ||
+    !Number.isSafeInteger(result.csrf_expires_at)
+  ) {
+    clearAuthToken();
+    redirectToDigitalMateLogin();
+    throw new Error("Not authenticated");
+  }
+  setCsrfToken(result.csrf_token, Number(result.csrf_expires_at));
+  if (!hasFreshCsrfToken()) {
+    clearAuthToken();
+    throw new Error("Invalid CSRF token expiry");
+  }
+}
+
+function waitForSharedRefresh(
+  refresh: Promise<void>,
+  callerSignal?: AbortSignal | null,
+): Promise<void> {
+  if (!callerSignal) return refresh;
+  if (callerSignal.aborted) {
+    return Promise.reject(getCallerAbortReason(callerSignal));
+  }
+  return new Promise<void>((resolve, reject) => {
+    const cleanup = () => {
+      callerSignal.removeEventListener("abort", onAbort);
+    };
+    const onAbort = () => {
+      cleanup();
+      reject(getCallerAbortReason(callerSignal));
+    };
+    callerSignal.addEventListener("abort", onAbort, { once: true });
+    refresh.then(
+      () => {
+        cleanup();
+        resolve();
+      },
+      (error: unknown) => {
+        cleanup();
+        reject(error);
+      },
+    );
+  });
+}
+
+function throwIfCallerAborted(
+  callerSignal?: AbortSignal | null,
+): void {
+  if (callerSignal?.aborted) {
+    throw getCallerAbortReason(callerSignal);
+  }
+}
+
+function getCallerAbortReason(signal: AbortSignal): unknown {
+  return (
+    signal.reason ??
+    new DOMException("The operation was aborted", "AbortError")
+  );
+}
+
+function redirectToDigitalMateLogin(): void {
+  if (window.location.pathname === "/login") return;
+  const returnTo = `${window.location.pathname}${window.location.search}`;
+  const safeReturnTo =
+    returnTo.startsWith("/") && !returnTo.startsWith("//")
+      ? returnTo
+      : "/admin";
+  window.location.assign(
+    `/login?redirect=${encodeURIComponent(safeReturnTo)}`,
+  );
+}
