index 9786946..8683148 100644
--- a/src/api/authHeaders.ts
+++ b/src/api/authHeaders.ts
@@ -1 +1 @@
-import { getApiToken } from "./config";
+import { getCsrfToken } from "./config";
@@ -3 +3,3 @@ import { getApiToken } from "./config";
-/** Authorization + X-Agent-Id for API requests. Caller sets Content-Type when needed. */
+const MUTATION_METHODS = new Set(["POST", "PUT", "PATCH", "DELETE"]);
+
+/** X-Agent-Id for all API requests. Caller sets Content-Type when needed. */
@@ -6,4 +7,0 @@ export function buildAuthHeaders(): Record<string, string> {
-  const token = getApiToken();
-  if (token) {
-    headers.Authorization = `Bearer ${token}`;
-  }
@@ -26,0 +25,13 @@ export function buildAuthHeaders(): Record<string, string> {
+
+/** X-Agent-Id plus in-memory CSRF for state-changing requests only. */
+export function buildMutationHeaders(method: string): Record<string, string> {
+  const headers = buildAuthHeaders();
+  if (!MUTATION_METHODS.has(method.toUpperCase())) {
+    return headers;
+  }
+  const csrfToken = getCsrfToken();
+  if (csrfToken) {
+    headers["x-csrf-token"] = csrfToken;
+  }
+  return headers;
+}
