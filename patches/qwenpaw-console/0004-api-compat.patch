diff --git a/src/api/agentScope.ts b/src/api/agentScope.ts
new file mode 100644
index 0000000..029aec5
--- /dev/null
+++ b/src/api/agentScope.ts
@@ -0,0 +1,20 @@
+const CANONICAL_UUID =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+
+let validatedDefaultAgentId: string | null = null;
+
+export function isCanonicalAgentId(value: unknown): value is string {
+  return typeof value === "string" && CANONICAL_UUID.test(value);
+}
+
+export function markValidatedDefaultAgent(agentId: string): void {
+  validatedDefaultAgentId = isCanonicalAgentId(agentId) ? agentId : null;
+}
+
+export function clearValidatedDefaultAgent(): void {
+  validatedDefaultAgentId = null;
+}
+
+export function getValidatedDefaultAgent(): string | null {
+  return validatedDefaultAgentId;
+}
