+import type {
+  AgentBehaviorSettings,
+  AgentPersona,
+  UpdateAgentProfileRequest,
+} from "@/api/types/agents";
+
+export interface AgentProfileFormValues {
+  id: string;
+  name: string;
+  persona: AgentPersona;
+  settings: AgentBehaviorSettings;
+  revision: number;
+  [key: string]: unknown;
+}
+
+export function buildAgentProfileUpdate(
+  values: AgentProfileFormValues,
+  operationId: string,
+): UpdateAgentProfileRequest {
+  return {
+    id: values.id,
+    name: values.name.trim(),
+    persona: {
+      name: values.persona.name.trim(),
+      style: values.persona.style.trim(),
+      emojiHabit: values.persona.emojiHabit.trim(),
+    },
+    settings: {
+      proactivity: {
+        quietStart: values.settings.proactivity.quietStart,
+        quietEnd: values.settings.proactivity.quietEnd,
+        minIntervalMinutes:
+          values.settings.proactivity.minIntervalMinutes,
+        maxPerHour: values.settings.proactivity.maxPerHour,
+        maxPerDay: values.settings.proactivity.maxPerDay,
+      },
+      cadence: {
+        responseDelayMs: values.settings.cadence.responseDelayMs,
+        segmentDelayMs: values.settings.cadence.segmentDelayMs,
+        maxSegments: values.settings.cadence.maxSegments,
+      },
+      search: {
+        aggressiveness: values.settings.search.aggressiveness,
+      },
+    },
+    revision: values.revision,
+    operation_id: operationId,
+  };
+}
+
+export function createAgentProfileUpdate(
+  values: AgentProfileFormValues,
+  createOperationId: () => string = () => crypto.randomUUID(),
+): UpdateAgentProfileRequest {
+  return buildAgentProfileUpdate(values, createOperationId());
+}
