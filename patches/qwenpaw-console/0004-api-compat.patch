+        default: "",
+      },
+      {
+        name: "encryption",
+        label: "Encryption",
+        type: "switch",
+        default: false,
+      },
+    ],
+  } satisfies ChannelSchema;
+  const buildMatrixPayload = buildChannelSavePayload as (
+    current: ChannelConfigResponse,
+    values: Record<string, unknown>,
+    schema: ChannelSchema,
+    operationId: string,
+    channelType: string,
+  ) => ChannelUpdatePayload;
+
+  it("switches password to token by explicitly clearing password", () => {
+    const payload = buildMatrixPayload(
+      configWithSecrets({
+        access_token: { configured: false, lastRotatedAt: null },
+        password: { configured: true, lastRotatedAt: null },
+      }),
+      {
+        auth_method: "token",
+        access_token: "next-token",
+        password: "",
+      },
+      matrixSchema,
+      OPERATION_ID,
+      "matrix",
+    );
+
+    expect(payload).toMatchObject({
+      access_token: "next-token",
+      clear_secret: ["password"],
+    });
+    expect(payload).not.toHaveProperty("auth_method");
+    expect(payload).not.toHaveProperty("password");
+  });
+
+  it("switches token to password by explicitly clearing access token", () => {
+    const payload = buildMatrixPayload(
+      configWithSecrets({
+        access_token: { configured: true, lastRotatedAt: null },
+        password: { configured: false, lastRotatedAt: null },
+      }),
+      {
+        auth_method: "password",
+        access_token: "",
+        password: "next-password",
