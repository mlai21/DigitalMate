+
+/** X-Agent-Id plus in-memory CSRF for state-changing requests only. */
+export function buildMutationHeaders(method: string): Record<string, string> {
+  const headers = buildAuthHeaders();
+  if (!MUTATION_METHODS.has(method.toUpperCase())) {
+    return headers;
+  }
+  const csrfToken = getCsrfToken();
+  if (csrfToken) {
+    headers["x-csrf-token"] = csrfToken;
+  }
+  return headers;
+}
