# =============================================================================
# DigitalMate 环境变量模板
#
# 使用方式：
#   cp .env.example .env
#   然后编辑 .env，填入你的 API Key 和配置
#
# 详细说明见 docs/env.md
# 切勿将 .env 提交到 Git
# =============================================================================

# -----------------------------------------------------------------------------
# KIE.AI 统一 API（Gemini / Claude 共用）
# 控制台：https://kie.ai
# -----------------------------------------------------------------------------
KIE_AI_API_KEY=
KIE_AI_BASE_URL=https://api.kie.ai

# -----------------------------------------------------------------------------
# Web 应用与数据库
# -----------------------------------------------------------------------------
# HTTPS 域名（Docker Compose 部署时由 Caddy 使用）
# 填入解析到本服务器的域名（如 mate.example.com）即自动启用 HTTPS；
# 多个域名用空格分隔（如 ginkgo.xin www.ginkgo.xin）。
# Docker Compose 生产部署不得留空。
DOMAIN=
DATABASE_URL=postgres://digitalmate:digitalmate@localhost:5432/digitalmate
# Docker Compose 部署时数据库密码（生产环境务必改成强口令）
# 改了这里后，DATABASE_URL 里的密码也要同步
POSTGRES_PASSWORD=digitalmate
APP_PASSWORD=
# 生产环境必须替换为至少 32 字节的独立高熵随机值
APP_SECRET=change-me-use-at-least-32-random-bytes
# 渠道凭据独立加密密钥：必须是 32 字节的标准 base64，不得复用 APP_SECRET。
# 可用 `openssl rand -base64 32` 生成；缺失或无效时渠道密钥能力保持 blocked。
CHANNEL_SECRETS_KEY=
# 灾难恢复包独立加密密钥：必须是另一个 32 字节标准 base64，
# 不得复用 APP_SECRET 或 CHANNEL_SECRETS_KEY。
# 未配置时只禁用后台备份/恢复，不影响聊天与渠道运行。
BACKUP_ENCRYPTION_KEY=
BACKUP_STORAGE_DIR=
BACKUP_RETENTION_DAYS=30
# 默认不信任代理头。Docker Compose 的 Caddy→web 链路会清洗来源头并注入原始 URI；
# 直接运行 Next.js 不提供严格原始路径保证，不得作为生产入口，也不要把本项改为 true。
TRUST_PROXY_HEADERS=false
# 正式 /admin 是否启用新 Console；设为 0 时回退到 /admin-legacy。
ADMIN_CONSOLE_ENABLED=0
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 阿里云 IQS 检索增强（联网搜索 / 网页解析）
# 控制台：https://iqs.console.aliyun.com/api-keys
# 接入文档：docs/api/阿里云检索增强IQS接入文档.md
# 鉴权：Authorization: Bearer <ALIYUN_IQS_API_KEY>
# -----------------------------------------------------------------------------
ALIYUN_IQS_API_KEY=
ALIYUN_IQS_BASE_URL=https://cloud-iqs.aliyuncs.com

# -----------------------------------------------------------------------------
# 搜索与主动性参数
# -----------------------------------------------------------------------------
# 搜索提供商：duckduckgo（默认占位）| iqs（阿里云 IQS，需填入上方 API Key）
SEARCH_PROVIDER=duckduckgo
PROACTIVE_QUIET_START=23:00
PROACTIVE_QUIET_END=08:00
PROACTIVE_MAX_PER_DAY=3

# -----------------------------------------------------------------------------
# GitHub Skill 导入（可选，提升 API 限额；公开仓库不填也可用）
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# P1 IM 渠道
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
DINGTALK_ROBOT_CODE=
# 仅用于首次迁移旧环境变量；默认导入为禁用连接。设为 1 才会同时启用。
CHANNEL_IMPORT_LEGACY_ENABLED=0

# 渠道公网入口由 Caddy 转发到 3101；受限 iMessage/SIP 节点通过 9443 mTLS 连接。
CHANNEL_GATEWAY_PORT=3101
CHANNEL_NODE_PORT=9443
# Docker Compose 生产部署必填，必须是与 DOMAIN 对应的 HTTPS 根地址。
PUBLIC_BASE_URL=
# 宿主机目录以只读方式挂载到 agent 容器。
CHANNEL_NODE_TLS_DIR=./data/channel-node-tls
# Web 后台单独挂载 enrollment CA，目录内不要放网关服务端私钥。
CHANNEL_NODE_ENROLLMENT_CA_DIR=./data/channel-node-enrollment-ca
# Web 后台只读挂载网关服务端公开信任根；两套 CA 必须是不同公钥的独立自签根。
CHANNEL_NODE_SERVER_CA_DIR=./data/channel-node-server-ca
# 三项必须同时配置；留空时受限渠道节点入口保持 disabled。
# Docker 部署请使用 /run/digitalmate/channel-node-tls 下的容器内路径。
# CHANNEL_NODE_TLS_CERT_PATH=/run/digitalmate/channel-node-tls/server.crt
# CHANNEL_NODE_TLS_KEY_PATH=/run/digitalmate/channel-node-tls/server.key
# CHANNEL_NODE_CA_PATH=/run/digitalmate/channel-node-tls/client-ca.crt
CHANNEL_NODE_TLS_CERT_PATH=
CHANNEL_NODE_TLS_KEY_PATH=
CHANNEL_NODE_CA_PATH=
# Web 打包给 runner 的网关服务端自签信任根，只含公开证书。
# CHANNEL_NODE_SERVER_CA_PATH=/run/digitalmate/channel-node-server-ca/server-ca.crt
CHANNEL_NODE_SERVER_CA_PATH=
# 下面两项由 Web 后台读取，用于签发短期节点证书；必须同时配置。
# Agent 网关不应获得 enrollment CA 私钥。
# CHANNEL_NODE_ENROLLMENT_CA_PATH=/run/digitalmate/channel-node-enrollment-ca/client-ca.crt
# CHANNEL_NODE_ENROLLMENT_CA_KEY_PATH=/run/digitalmate/channel-node-enrollment-ca/client-ca.key
CHANNEL_NODE_ENROLLMENT_CA_PATH=
CHANNEL_NODE_ENROLLMENT_CA_KEY_PATH=

# -----------------------------------------------------------------------------
# Gemini 3.5 Flash（OpenAI 兼容格式）
# 接入文档：docs/api/gemini3-5-flash接入文档.md
# 鉴权：Authorization: Bearer <KIE_AI_API_KEY>
# 说明：KIE 网关一个模型一条路径，其余 OpenAI 兼容模型按模型 id 自动推导为
#       /<model>/v1/chat/completions，只有这个模型保留可覆盖的显式配置。
# -----------------------------------------------------------------------------
GEMINI_3_5_FLASH_ENDPOINT=/gemini-3-5-flash-openai/v1/chat/completions

# -----------------------------------------------------------------------------
# 阿里云百炼 Model Studio（OpenAI 兼容格式，Qwen 系列走这里，不在 KIE 网关上）
# 控制台：https://bailian.console.aliyun.com/ → 右上角选地域 → API Key
# 接入文档：docs/api/阿里云百炼qwen3.7-max接入文档.md
# 鉴权：Authorization: Bearer <MODEL_STUDIO_API_KEY>
# 注意：与 ALIYUN_IQS_API_KEY（智能搜索 IQS）不是同一把密钥；各地域密钥互不通用，
#       Base URL 必须与创建密钥的地域一致。推荐换成业务空间专属域名：
#       https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# -----------------------------------------------------------------------------
MODEL_STUDIO_API_KEY=
MODEL_STUDIO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -----------------------------------------------------------------------------
# Claude Opus 4.6 / 4.8（Anthropic Messages API）
# 接入文档：
#   docs/api/claude-opus-4-6接入文档.md
#   docs/api/claude-opus-4-8接入文档.md
# 鉴权：Authorization: Bearer <KIE_AI_API_KEY>，请求头需带 anthropic-version
# -----------------------------------------------------------------------------
CLAUDE_MESSAGES_ENDPOINT=/claude/v1/messages
ANTHROPIC_API_VERSION=2023-06-01

# -----------------------------------------------------------------------------
# 模型路由（实现阶段按用途选用，见 PRD 7.3）
# -----------------------------------------------------------------------------
# 主对话 / 复杂任务
LLM_MODEL_MAIN=claude-opus-4-8
# 高频轻量调用（插话判断、记忆抽取等）
LLM_MODEL_LIGHT=gemini-3-5-flash-openai
# 主模型供应商故障（5xx/408/429）时按顺序降级的备用模型，逗号分隔；留空表示不降级。
# 备用模型同样受 Agent 模型授权约束，未授权的会被忽略。
# 末尾建议留一个不同供应商的模型：同一网关上的模型会一起故障，跨供应商才是真兜底。
LLM_MODEL_MAIN_FALLBACKS=qwen3.7-max,gemini-3-6-flash-openai

# -----------------------------------------------------------------------------
# 记忆向量 Embedding（可选，OpenAI 兼容 /embeddings 接口）
# 不配置时降级为本地伪向量（召回质量下降，但功能可用）
# 维度必须与 schema.sql 中 vector(1536) 一致
# -----------------------------------------------------------------------------
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
